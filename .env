# Copy to backend/.env (never commit .env). Loaded by Node's --env-file-if-exists flag.
# Variables already set in the shell take precedence over this file.

# HTTP port, 1-65535. Default 3000.
PORT=3000

# Required. Runtime role only (agentdesk_app), never postgres or supabase_admin.
# Supabase session pooler, port 5432. URL-encode special characters in the password.
# Do not add sslmode or other SSL parameters: TLS is configured in code.
DATABASE_URL=postgresql://agentdesk_app.nehiaccmqiludnxuebbp:H9lYogI4_AJUF3RhJ41VnMd67-K9d_Q20WlIY0JQIZw@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Required. Supabase CA certificate (PEM). Relative paths resolve from backend/.
DATABASE_CA_CERT_PATH=certs/prod-ca-2021.crt

# Optional pool settings (defaults shown).
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# --- Authentication (custom, in Express) ---
# At least 32 bytes. Generated locally. Do not commit this file.
JWT_SECRET=m1pMKs3FiHI8s41LWv7sy/XnLnSxsnlAUMuILojtOmipaNasB5p5T7Fvbq/8AuYI

# Required. Replace re_replace_me with a real Resend key before testing email.
RESEND_API_KEY=re_replace_me
# Required. A sender on a domain verified in Resend, or Name <address>.
EMAIL_FROM=AgentDesk <no-reply@example.com>
